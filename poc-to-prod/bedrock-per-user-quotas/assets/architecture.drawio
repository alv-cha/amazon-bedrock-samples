        <mxCell id="b1-t1" value="Client sends the &lt;b&gt;unchanged&lt;/b&gt; OpenAI / Anthropic wire request — just a base_url swap (SigV4 + JWT)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="b1"><mxGeometry x="1178" y="170" width="396" height="55" as="geometry"/></mxCell>
        <mxCell id="b1-b2" value="3" style="ellipse;html=1;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="b1"><mxGeometry x="1140" y="233" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="b1-t2" value="&lt;b&gt;RESERVE&lt;/b&gt; worst case atomically in DynamoDB &lt;i&gt;before&lt;/i&gt; forwarding; after the response, &lt;b&gt;SETTLE&lt;/b&gt; down to real usage" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="b1"><mxGeometry x="1178" y="233" width="396" height="55" as="geometry"/></mxCell>
        <mxCell id="b1-b3" value="!" style="ellipse;html=1;fillColor=#C62828;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="b1"><mxGeometry x="1140" y="296" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="b1-t3" value="Over budget → &lt;b&gt;429 refused before any tokens are spent&lt;/b&gt; — zero overspend" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="b1"><mxGeometry x="1178" y="296" width="396" height="38" as="geometry"/></mxCell>
        <mxCell id="b1-b4" value="4" style="ellipse;html=1;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="b1"><mxGeometry x="1140" y="342" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="b1-t4" value="Forward to &lt;b&gt;bedrock-mantle&lt;/b&gt; with a short-term token minted from the gateway role — users never hold AWS creds. Mantle is &lt;b&gt;not&lt;/b&gt; captured by model-invocation logging, so metering must be in-band (this proxy) — that is why mantle uses Mode B, not Mode A." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="b1"><mxGeometry x="1178" y="342" width="396" height="72" as="geometry"/></mxCell>
        <mxCell id="b1-b5" value="5" style="ellipse;html=1;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="b1"><mxGeometry x="1140" y="405" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="b1-t5" value="Response / SSE stream teed back to the client; real token usage extracted on the fly" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="b1"><mxGeometry x="1178" y="405" width="396" height="38" as="geometry"/></mxCell>
        <mxCell id="b1-b6" value="6" style="ellipse;html=1;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="b1"><mxGeometry x="1140" y="451" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="b1-t6" value="Per-request EMF metrics → per-user CloudWatch dashboard" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="b1"><mxGeometry x="1178" y="451" width="396" height="38" as="geometry"/></mxCell>
        <mxCell id="b1-b7" value="7" style="ellipse;html=1;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="b1"><mxGeometry x="1140" y="497" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="b1-t7" value="Reconciler drift-checks settled usage; blocks / auto-unblocks users" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="b1"><mxGeometry x="1178" y="497" width="396" height="38" as="geometry"/></mxCell>
        <mxCell id="b1-b8" value="8" style="ellipse;html=1;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="b1"><mxGeometry x="1140" y="543" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="b1-t8" value="SNS alerts at 80% of budget and on block" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="b1"><mxGeometry x="1178" y="543" width="396" height="24" as="geometry"/></mxCell>
        <mxCell id="b1-pp" value="&lt;b&gt;Key properties&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Zero overspend&lt;/b&gt; — hard cap enforced before the model is called&lt;br&gt;• Adds ~8–15 ms p50 (warm) per call — the gateway is in the data path&lt;br&gt;• Covers OpenAI &amp; Anthropic protocols via bedrock-mantle&lt;br&gt;• Pick Mode B when a strict cap matters more than latency; else prefer Mode A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#37474F;" vertex="1" parent="b1"><mxGeometry x="1140" y="581" width="434" height="149" as="geometry"/></mxCell>
        <mxCell id="b1-pl" value="&lt;font color=&quot;#78909C&quot;&gt;— identity&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;— data path&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#1565C0&quot;&gt;— quota logic&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#C62828&quot;&gt;--- 429&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#E65100&quot;&gt;--- async&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#607D8B;" vertex="1" parent="b1"><mxGeometry x="1140" y="744" width="434" height="26" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
