        <mxCell id="a1-pt" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Mode A — Credential broker (default)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot;&gt;Enforcement &lt;b&gt;out of the data path&lt;/b&gt; · any Bedrock API, model &amp; provider&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#263238;" vertex="1" parent="a1"><mxGeometry x="1140" y="58" width="434" height="52" as="geometry"/></mxCell>
        <mxCell id="a1-psep" value="" style="line;strokeColor=#E0E0E0;html=1;" vertex="1" parent="a1"><mxGeometry x="1140" y="122" width="434" height="8" as="geometry"/></mxCell>
        <mxCell id="a1-b0" value="1" style="ellipse;html=1;fillColor=#78909C;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="a1"><mxGeometry x="1140" y="138" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="a1-t0" value="User signs in at your IdP → gets a JWT (claim &lt;i&gt;sub&lt;/i&gt; = quota identity)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="a1"><mxGeometry x="1178" y="138" width="396" height="38" as="geometry"/></mxCell>
        <mxCell id="a1-b1" value="2" style="ellipse;html=1;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="a1"><mxGeometry x="1140" y="184" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="a1-t1" value="App calls &lt;b&gt;POST /v1/credentials&lt;/b&gt; (SigV4 + JWT); broker verifies the JWT via the IdP JWKS" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="a1"><mxGeometry x="1178" y="184" width="396" height="55" as="geometry"/></mxCell>
        <mxCell id="a1-b2" value="3" style="ellipse;html=1;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="a1"><mxGeometry x="1140" y="247" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="a1-t2" value="&lt;b&gt;Budget gate&lt;/b&gt; in DynamoDB — blocked → 403, over budget → 429: no credentials issued" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="a1"><mxGeometry x="1178" y="247" width="396" height="38" as="geometry"/></mxCell>
        <mxCell id="a1-b3" value="4" style="ellipse;html=1;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="a1"><mxGeometry x="1140" y="293" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="a1-t3" value="STS &lt;b&gt;AssumeRole → BedrockUserRole&lt;/b&gt;: SourceIdentity = sanitized(sub), server-stamped, tamper-proof · TTL ≤ 15 min" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="a1"><mxGeometry x="1178" y="293" width="396" height="55" as="geometry"/></mxCell>
        <mxCell id="a1-b4" value="5" style="ellipse;html=1;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="a1"><mxGeometry x="1140" y="356" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="a1-t4" value="Short-lived AWS credentials returned to the app" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="a1"><mxGeometry x="1178" y="356" width="396" height="24" as="geometry"/></mxCell>
        <mxCell id="a1-b5" value="6" style="ellipse;html=1;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="a1"><mxGeometry x="1140" y="388" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="a1-t5" value="App calls Bedrock &lt;b&gt;natively&lt;/b&gt; — Converse / InvokeModel / streaming, any provider. &lt;b&gt;Broker not in this path: ~0 latency&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="a1"><mxGeometry x="1178" y="388" width="396" height="55" as="geometry"/></mxCell>
        <mxCell id="a1-b6" value="7" style="ellipse;html=1;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="a1"><mxGeometry x="1140" y="451" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="a1-t6" value="Bedrock &lt;b&gt;model-invocation logging&lt;/b&gt; records token counts + session identity of every call — this captures the &lt;b&gt;bedrock-runtime&lt;/b&gt; endpoint, which is why Mode A can meter out-of-path (mantle is not logged → use Mode B)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="a1"><mxGeometry x="1178" y="451" width="396" height="60" as="geometry"/></mxCell>
        <mxCell id="a1-b7" value="8" style="ellipse;html=1;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="a1"><mxGeometry x="1140" y="497" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="a1-t7" value="Reconciler sums tokens per session (Logs Insights)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="a1"><mxGeometry x="1178" y="497" width="396" height="24" as="geometry"/></mxCell>
        <mxCell id="a1-b8" value="9" style="ellipse;html=1;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="a1"><mxGeometry x="1140" y="529" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="a1-t8" value="Prices usage, updates counters, &lt;b&gt;blocks / auto-unblocks&lt;/b&gt; users" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="a1"><mxGeometry x="1178" y="529" width="396" height="38" as="geometry"/></mxCell>
        <mxCell id="a1-b9" value="10" style="ellipse;html=1;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="a1"><mxGeometry x="1140" y="575" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="a1-t9" value="SNS alerts at 80% and on block · per-user CloudWatch dashboard" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;spacingLeft=2;" vertex="1" parent="a1"><mxGeometry x="1178" y="575" width="396" height="38" as="geometry"/></mxCell>
        <mxCell id="a1-pp" value="&lt;b&gt;Key properties&lt;/b&gt;&lt;br&gt;• Bounded overspend ≤ credential TTL (15 min) + reconciler lag — a blocked user cannot renew&lt;br&gt;• Identity is tamper-proof (SourceIdentity, server-stamped)&lt;br&gt;• SCP / deny policy ⇒ the vended role is the &lt;b&gt;only&lt;/b&gt; path to Bedrock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#37474F;" vertex="1" parent="a1"><mxGeometry x="1140" y="627" width="434" height="115" as="geometry"/></mxCell>
        <mxCell id="a1-pl" value="&lt;font color=&quot;#78909C&quot;&gt;— identity&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#1565C0&quot;&gt;— control plane&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;— data plane&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#E65100&quot;&gt;--- async&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#607D8B;" vertex="1" parent="a1"><mxGeometry x="1140" y="756" width="434" height="26" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
