{
  "alert_email": "platform-alerts@example.com",
  "jwt_issuer": "https://idp.example.com",
  "jwt_audience": "bedrock-quota-gateway",
  "jwt_user_claim": "custom:tenant_id",
  "admin_ui": false,
  "admin_jwt_claim": "",
  "admin_jwt_value": "",
